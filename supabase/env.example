# Copy thành .env ở root project, rồi điền key từ Supabase mới

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Chỉ cấu hình trên Vercel/server, không thêm tiền tố VITE_ để tránh lộ khóa ra trình duyệt
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# (Tuỳ chọn) OpenAI dự phòng khi không cấu hình Groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# (Tuỳ chọn) Firebase — cần nếu dùng chấm công / phê duyệt / KPI...
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
